{
  "name": "glados-free-checkin",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 1,9 * * *"] },
  "kv_namespaces": [
    { "binding": "CHECKIN_STATE", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
